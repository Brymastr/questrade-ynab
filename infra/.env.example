# Per-environment deploy config, read by the CDK app.
# Copy to infra/.env.<env> — e.g. infra/.env.dev (and later infra/.env.prod).
# Select which one with APP_ENV (default "dev"): `APP_ENV=prod make deploy`.
# Values shared across environments can go in infra/.env instead.
# (Real shell env vars override everything.)

# The app's public hostname for this environment.
DOMAIN_NAME=qy-dev.example.com

# An existing Route53 hosted zone that covers DOMAIN_NAME.
HOSTED_ZONE_NAME=example.com

# Secrets Manager secret name (optional; defaults to questrade-ynab/<env>).
# SECRETS_NAME=questrade-ynab/dev
