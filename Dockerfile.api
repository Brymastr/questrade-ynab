FROM golang:1.21-alpine AS builder
WORKDIR /app
RUN apk add --no-cache gcc musl-dev
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -o /questrade-ynab .

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /questrade-ynab .
RUN mkdir -p /data
VOLUME ["/data"]
EXPOSE 8080
CMD ["./questrade-ynab", "serve"]
