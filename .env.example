# Copy to .env and fill in values before running.

# Public URL of your deployment (no trailing slash)
APP_URL=http://localhost:8080

# --- Cloudflare Tunnel ---
# Token from: Cloudflare Zero Trust -> Networks -> Tunnels -> (your tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me

# --- Server ---
# Port the Go API server listens on
PORT=8080
# SQLite database path
DATABASE_PATH=./data/app.db
# Allowed CORS origin for the frontend (Vite dev server)
CORS_ORIGIN=http://localhost:5173
# Set to "false" for local HTTP dev so session/state cookies are sent over http.
# Leave unset (defaults to secure) in production behind HTTPS.
COOKIE_SECURE=false

# --- Questrade OAuth app credentials ---
# Register at: https://www.questrade.com/api/documentation/getting-started
# The redirect URI below MUST match the one registered on your Questrade app exactly.
QUESTRADE_CLIENT_ID=
QUESTRADE_CLIENT_SECRET=
QUESTRADE_REDIRECT_URI=http://localhost:8080/auth/questrade/callback

# --- YNAB OAuth app credentials ---
# Register at: https://app.ynab.com/settings/developer
# The redirect URI below MUST match the one registered on your YNAB app exactly.
YNAB_CLIENT_ID=
YNAB_CLIENT_SECRET=
YNAB_REDIRECT_URI=http://localhost:8080/auth/ynab/callback
