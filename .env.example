# Copy to .env and fill in values before running.

# Public URL of your deployment (no trailing slash)
APP_URL=http://localhost:8080

# --- Cloudflare Tunnel ---
# Token from: Cloudflare Zero Trust -> Networks -> Tunnels -> (your tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me

# --- Server ---
# Port the Go API server listens on
PORT=8080
# Allowed CORS origin for the frontend (Vite dev server)
CORS_ORIGIN=http://localhost:5173
# Set to "false" for local HTTP dev so session/state cookies are sent over http.
# Leave unset (defaults to secure) in production behind HTTPS.
COOKIE_SECURE=false

# --- Database backend ---
# "sqlite" (default) for local dev, or "dynamo" for DynamoDB (AWS Lambda).
DB_BACKEND=sqlite
# SQLite database path (used when DB_BACKEND=sqlite)
DATABASE_PATH=./data/app.db
# DynamoDB table name (required when DB_BACKEND=dynamo). AWS region/credentials
# come from the standard AWS config chain (env / instance / Lambda role).
DYNAMO_TABLE=

# --- Questrade credentials ---
# Questrade personal apps do not support the interactive OAuth redirect flow, so
# the app uses a manually generated refresh token pasted into the UI. Only the
# client id/secret are needed to exchange it.
QUESTRADE_CLIENT_ID=
QUESTRADE_CLIENT_SECRET=

# --- YNAB OAuth app credentials ---
# Register at: https://app.ynab.com/settings/developer
# The redirect URI below MUST match the one registered on your YNAB app exactly.
# Local dev goes through the Vite proxy on :5173; production uses your domain.
YNAB_CLIENT_ID=
YNAB_CLIENT_SECRET=
YNAB_REDIRECT_URI=http://localhost:5173/auth/ynab/callback
